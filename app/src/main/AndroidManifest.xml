<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Translations are fetched from the admin API and Supabase. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SkarnikApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Skarnik">
        <!-- Same activity class name as the Flutter app, so launcher shortcuts survive the upgrade. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- «Слова дня». Same class name as the Flutter app's provider, so placed widgets survive the upgrade. -->
        <receiver
            android:name=".widget.WordOfDayWidgetReceiver"
            android:exported="true"
            android:label="@string/word_of_the_day_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/word_of_the_day_widget_info" />
        </receiver>

        <!-- WorkManager is initialised by SkarnikApplication with Hilt's worker factory, not by App Startup. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
