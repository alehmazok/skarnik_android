<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Translations are fetched from the admin API and Supabase. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SkarnikApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Skarnik">
        <!-- Same activity class name as the Flutter app, so launcher shortcuts survive the upgrade. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Word links (parity 9.1, 9.2). WordLinkIntents parses the URL; a link that does not parse just opens
                 the app. Verified App Links need /.well-known/assetlinks.json on each host with the app signing
                 key's SHA-256; an unverified host still works when the user allows it in the app's settings. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="skarnik.by" />
                <data android:host="www.skarnik.by" />
                <data android:pathPrefix="/belrus/" />
                <data android:pathPrefix="/rusbel/" />
                <data android:pathPrefix="/tsbm/" />
            </intent-filter>
            <!-- Share links from the app (skarnik.app/r/<dict>/<id>). Only /r/, so the landing page stays in the
                 browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="skarnik.app" />
                <data android:host="www.skarnik.app" />
                <data android:pathPrefix="/r/" />
            </intent-filter>
        </activity>

        <!-- «Слова дня». Same class name as the Flutter app's provider, so placed widgets survive the upgrade. -->
        <receiver
            android:name=".widget.WordOfDayWidgetReceiver"
            android:exported="true"
            android:label="@string/word_of_the_day_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/word_of_the_day_widget_info" />
        </receiver>

        <!-- Analytics (docs/adr/0007): off until the user allows it in the consent dialog; AnalyticsConsent turns it
             on. Debug builds are deactivated for good. No screen views (as Flutter) and no advertising id: the
             consent text promises anonymous statistics. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="${analyticsDeactivated}" />
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- WorkManager is initialised by SkarnikApplication with Hilt's worker factory, not by App Startup. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
